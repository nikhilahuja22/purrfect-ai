{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
		"db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.61.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.6",
		"bits-ui": "^2.20.2",
		"cn": "^0.5.0",
		"drizzle-kit": "^0.31.11",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1159.0",
		"@aws-sdk/s3-request-presigner": "^3.1159.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@napi-rs/canvas": "^1.1.0",
		"@node-rs/bcrypt": "^2.0.0",
		"drizzle-orm": "^0.45.4",
		"joi": "^18.3.0",
		"pdfjs-dist": "^6.5.438",
		"postgres": "^3.4.9",
		"tesseract.js": "^7.0.0"
	}
}
